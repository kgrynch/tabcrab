{
    "manifest_version": 3,
    "name": "Tab Crab",
    "version": "4.0",
    "description": "Manage tabs from all windows in one place. Automatically groups by website, helping you consolidate, sort, and navigate with ease.",
    "permissions": [
        "tabs",
        "tabGroups",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html",
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+K",
                "mac": "MacCtrl+Shift+K"
            }
        },
        "consolidate-windows": {
            "suggested_key": {
                "default": "Ctrl+Shift+L",
                "mac": "MacCtrl+Shift+L"
            },
            "description": "Gather all tabs into the current window"
        },
        "sort-tabs": {
            "suggested_key": {
                "default": "Ctrl+Shift+J",
                "mac": "MacCtrl+Shift+J"
            },
            "description": "Sort tabs in the current window"
        }
    }
}
